# The local source archive is an explicit delivery set. No registry upload is
# performed by the consumer check. Keep licenses, examples and verification tools.
/*
!/*.mbt
!/moon.mod
!/moon.pkg
!/pkg.generated.mbti
!/LICENSE
!/README.md
!/README.mbt.md
!/THIRD_PARTY.md
!/CHANGELOG.md
!/cmd/
!/cmd/**/
!/cmd/**/*.mbt
!/cmd/**/moon.pkg
!/cmd/**/pkg.generated.mbti
!/internal/
!/internal/**/
!/internal/**/*.mbt
!/internal/**/moon.pkg
!/internal/**/pkg.generated.mbti
!/docs/
!/docs/*.md
!/docs/*.yml
!/docs/moon.pkg
!/docs/pkg.generated.mbti
!/fixtures/
!/fixtures/*.sql
!/fixtures/*.json
!/fixtures/RIVER_LICENSE
!/scripts/
!/scripts/*.mbtx
!/validation/
!/validation/sarif-schema-lock.json
!/validation/requirements.txt
!/validation/tooling-sources.md
**/_build/
**/target/
**/.mooncakes/
