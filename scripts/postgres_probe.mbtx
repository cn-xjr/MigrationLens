///|
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

///|
async fn psql(steps : Array[String]) -> @shell.Output {
  let args = [
    "-X", "-qAt", "-v", "ON_ERROR_STOP=1", "-v", "VERBOSITY=sqlstate", "-c", "SET lock_timeout=0",
  ]
  for sql in steps {
    args.push("-c")
    args.push(sql)
  }
  @shell.Cmd("psql", args).output(timeout_ms=30000)
}

///|
async fn successful(name : String, steps : Array[String]) -> @shell.Output {
  println("probe: \{name}")
  let output = psql(steps)
  guard output.exit_code() == 0 else {
    fail(
      "probe \{name}: psql exit=\{output.exit_code()}; stderr=\{output.stderr()}",
    )
  }
  output
}

///|
async fn rejected(
  name : String,
  steps : Array[String],
  sqlstate : String,
) -> Unit {
  println("probe: \{name} (expected SQLSTATE \{sqlstate})")
  let output = psql(steps)
  guard output.exit_code() != 0 && output.stderr().contains(sqlstate) else {
    fail(
      "probe \{name}: expected SQLSTATE \{sqlstate}; exit=\{output.exit_code()}; stderr=\{output.stderr()}",
    )
  }
}

///|
async fn main {
  guard @env.get_env_var("MIGRATIONLENS_DISPOSABLE_DB") == Some("1") &&
    @env.get_env_var("PGDATABASE") == Some("migrationlens_test") else {
    fail(
      "Set MIGRATIONLENS_DISPOSABLE_DB=1 and PGDATABASE=migrationlens_test for a disposable PostgreSQL 18 database",
    )
  }
  let version = successful("server version", ["SHOW server_version_num"])
  let version_number = @string.parse_int(version.stdout().trim())
  guard version_number >= 180000 && version_number < 190000 else {
    fail("PostgreSQL 18 required; server_version_num=\{version_number}")
  }
  println("server_version_num=\{version_number}")
  let _ = successful("create disposable probe table", [
    "CREATE TABLE migrationlens_probe(id integer)",
  ])
  let _ = successful("single concurrent index", [
    "CREATE INDEX CONCURRENTLY ml_probe_a ON migrationlens_probe(id)",
  ])
  let characteristics = successful("transaction modes with optional commas", [
    "BEGIN WORK ISOLATION LEVEL REPEATABLE READ READ WRITE, NOT DEFERRABLE", "SHOW transaction_isolation",
    "SHOW transaction_read_only", "SHOW transaction_deferrable", "ROLLBACK",
  ])
  assert_eq(
    characteristics.stdout().trim().to_owned(),
    "repeatable read\noff\noff",
  )
  let read_only = successful("serializable read-only deferrable transaction", [
    "START TRANSACTION ISOLATION LEVEL SERIALIZABLE, READ ONLY, DEFERRABLE", "SHOW transaction_read_only",
    "SHOW transaction_deferrable", "COMMIT",
  ])
  assert_eq(read_only.stdout().trim().to_owned(), "on\non")
  rejected(
    "mode-bearing BEGIN forbids concurrent index",
    [
      "BEGIN ISOLATION LEVEL READ COMMITTED, READ WRITE", "CREATE INDEX CONCURRENTLY ml_probe_bad ON migrationlens_probe(id)",
    ],
    "25001",
  )
  for
    (name, steps) in [
      (
        "existing explicit transaction",
        [
          "BEGIN", "CREATE INDEX CONCURRENTLY ml_probe_bad ON migrationlens_probe(id)",
        ],
      ),
      (
        "implicit simple-query transaction",
        [
          "SET lock_timeout='3s'; CREATE INDEX CONCURRENTLY ml_probe_bad ON migrationlens_probe(id)",
        ],
      ),
      (
        "simple-query after COMMIT",
        [
          "BEGIN; COMMIT; CREATE INDEX CONCURRENTLY ml_probe_bad ON migrationlens_probe(id)",
        ],
      ),
      (
        "batch closes caller transaction",
        [
          "BEGIN", "COMMIT; CREATE INDEX CONCURRENTLY ml_probe_bad ON migrationlens_probe(id)",
        ],
      ),
    ] {
    rejected(name, steps, "25001")
  }
  let _ = successful("separate session SET and concurrent index", [
    "SET lock_timeout='3s'", "CREATE INDEX CONCURRENTLY ml_probe_b ON migrationlens_probe(id)",
  ])
  for
    (name, steps, expected) in [
      (
        "local SET outside transaction",
        ["SET LOCAL lock_timeout='3s'", "SHOW lock_timeout"],
        "0",
      ),
      (
        "commit discards local SET",
        ["BEGIN", "SET LOCAL lock_timeout='3s'", "COMMIT", "SHOW lock_timeout"],
        "0",
      ),
      (
        "rollback to savepoint restores setting",
        [
          "BEGIN", "SAVEPOINT a", "SET LOCAL lock_timeout='3s'", "ROLLBACK TO a",
          "SHOW lock_timeout", "COMMIT",
        ],
        "0",
      ),
      (
        "rollback cancels session SET",
        ["BEGIN", "SET lock_timeout='3s'", "ROLLBACK", "SHOW lock_timeout"],
        "0",
      ),
      (
        "commit retains session SET",
        ["BEGIN", "SET lock_timeout='3s'", "COMMIT", "SHOW lock_timeout"],
        "3s",
      ),
      (
        "session SET overrides local SET",
        [
          "BEGIN", "SET LOCAL lock_timeout=0", "SET SESSION lock_timeout='2s'", "SHOW lock_timeout",
          "COMMIT",
        ],
        "2s",
      ),
      (
        "commit restores session under local override",
        [
          "SET lock_timeout='3s'", "BEGIN", "SET LOCAL lock_timeout=0", "COMMIT",
          "SHOW lock_timeout",
        ],
        "3s",
      ),
      (
        "same-name savepoint selects most recent",
        [
          "BEGIN", "SET LOCAL lock_timeout=0", "SAVEPOINT a", "SET LOCAL lock_timeout='3s'",
          "SAVEPOINT A", "SET LOCAL lock_timeout=0", "ROLLBACK TO a", "RELEASE a",
          "SHOW lock_timeout", "COMMIT",
        ],
        "3s",
      ),
      (
        "release retains current setting",
        [
          "BEGIN", "SAVEPOINT a", "SAVEPOINT b", "SET LOCAL lock_timeout='3s'", "RELEASE a",
          "SHOW lock_timeout", "COMMIT",
        ],
        "3s",
      ),
      (
        "quoted lower-case name matches unquoted",
        ["BEGIN", "SAVEPOINT \"a\"", "RELEASE A", "SHOW lock_timeout", "COMMIT"],
        "0",
      ),
    ] {
    let output = successful(name, steps)
    assert_eq(output.stdout().trim().to_owned(), expected, msg=name)
  }
  for
    (name, steps) in [
      (
        "release removes descendants",
        ["BEGIN", "SAVEPOINT a", "SAVEPOINT b", "RELEASE a", "ROLLBACK TO b"],
      ),
      (
        "rollback removes descendants",
        ["BEGIN", "SAVEPOINT a", "SAVEPOINT b", "ROLLBACK TO a", "RELEASE b"],
      ),
      (
        "quoted upper-case name remains distinct",
        ["BEGIN", "SAVEPOINT \"A\"", "RELEASE a"],
      ),
    ] {
    rejected(name, steps, "3B001")
  }
  let chain = successful(
    "chain discards local override and starts a fresh baseline",
    [
      "BEGIN", "SET lock_timeout='2s'", "SET LOCAL lock_timeout=0", "END AND CHAIN",
      "ABORT", "SHOW lock_timeout",
    ],
  )
  assert_eq(chain.stdout().trim().to_owned(), "2s")
  let rolled = successful("rollback chain restores prior session setting", [
    "BEGIN", "SET lock_timeout='2s'", "ABORT AND CHAIN", "END", "SHOW lock_timeout",
  ])
  assert_eq(rolled.stdout().trim().to_owned(), "0")
  rejected("idle chaining", ["COMMIT AND CHAIN"], "25P01")
  rejected(
    "implicit chaining",
    ["SET lock_timeout=100; ROLLBACK AND CHAIN"],
    "25P01",
  )
  rejected(
    "chained concurrent index",
    ["BEGIN", "COMMIT AND CHAIN", "DROP INDEX CONCURRENTLY ml_probe_a"],
    "25001",
  )
  rejected(
    "concurrent drop multiple names",
    ["DROP INDEX CONCURRENTLY ml_probe_a, ml_probe_b"],
    "0A000",
  )
  let _ = successful("qualified concurrent reindex", [
    "REINDEX INDEX CONCURRENTLY public.ml_probe_a",
  ])
  let _ = successful("REINDEX parenthesized concurrent and verbose", [
    "REINDEX (CONCURRENTLY ON, VERBOSE OFF) INDEX public.ml_probe_a",
  ])
  let _ = successful("REINDEX explicitly non-concurrent in transaction", [
    "BEGIN", "REINDEX (CONCURRENTLY FALSE) INDEX ml_probe_a", "COMMIT",
  ])
  rejected(
    "REINDEX parenthesized concurrent transaction conflict",
    ["BEGIN", "REINDEX (CONCURRENTLY 1) INDEX ml_probe_a"],
    "25001",
  )
  let _ = successful("ordinary reindex in explicit transaction", [
    "BEGIN", "REINDEX INDEX ml_probe_a", "COMMIT",
  ])
  rejected(
    "concurrent reindex explicit transaction",
    ["BEGIN", "REINDEX INDEX CONCURRENTLY ml_probe_a"],
    "25001",
  )
  rejected(
    "concurrent reindex implicit transaction",
    ["SET lock_timeout=100; REINDEX INDEX CONCURRENTLY ml_probe_a"],
    "25001",
  )
  rejected(
    "concurrent drop cascade",
    ["DROP INDEX CONCURRENTLY ml_probe_a CASCADE"],
    "0A000",
  )
  let moved = successful("single-index tablespace lock in transaction", [
    "BEGIN", "ALTER INDEX public.ml_probe_b SET TABLESPACE pg_default", "SELECT mode FROM pg_locks WHERE pid=pg_backend_pid() AND locktype='relation' AND relation='ml_probe_b'::regclass AND granted AND mode='AccessExclusiveLock'",
    "COMMIT",
  ])
  assert_eq(moved.stdout().trim().to_owned(), "AccessExclusiveLock")
  let _ = successful("qualified concurrent drop with RESTRICT", [
    "DROP INDEX CONCURRENTLY public.ml_probe_a RESTRICT",
  ])
  let _ = successful("rename existing index in transaction", [
    "BEGIN", "ALTER INDEX public.ml_probe_b RENAME TO ml_probe_renamed", "COMMIT",
  ])
  let _ = successful("restore index name", [
    "ALTER INDEX ml_probe_renamed RENAME TO ml_probe_b",
  ])
  let _ = successful("ordinary multi-name drop", [
    "DROP INDEX IF EXISTS public.ml_probe_b, public.ml_probe_missing CASCADE",
  ])
  let external_rollback = successful(
    "external rollback baseline differs from current session setting",
    [
      "SET lock_timeout='2s'", "BEGIN", "SET lock_timeout=100", "ROLLBACK", "SHOW lock_timeout",
    ],
  )
  assert_eq(external_rollback.stdout().trim().to_owned(), "2s")
  for
    (mode, held) in [
      ("ACCESS SHARE", "AccessShareLock"),
      ("ROW SHARE", "RowShareLock"),
      ("ROW EXCLUSIVE", "RowExclusiveLock"),
      ("SHARE UPDATE EXCLUSIVE", "ShareUpdateExclusiveLock"),
      ("SHARE", "ShareLock"),
      ("SHARE ROW EXCLUSIVE", "ShareRowExclusiveLock"),
      ("EXCLUSIVE", "ExclusiveLock"),
      ("ACCESS EXCLUSIVE", "AccessExclusiveLock"),
    ] {
    let acquired = successful("explicit table lock \{mode}", [
      "BEGIN",
      "LOCK TABLE migrationlens_probe IN \{mode} MODE NOWAIT",
      "SELECT mode FROM pg_locks WHERE pid=pg_backend_pid() AND locktype='relation' AND relation='migrationlens_probe'::regclass AND granted",
      "COMMIT",
    ])
    assert_eq(acquired.stdout().trim().to_owned(), held)
  }
  rejected(
    "idle LOCK requires a transaction block",
    ["LOCK TABLE migrationlens_probe"],
    "25P01",
  )
  let _ = successful("implicit block accepts LOCK", [
    "SET lock_timeout=100; LOCK TABLE migrationlens_probe IN SHARE MODE NOWAIT",
  ])
  let _ = successful("implicit segment after COMMIT accepts LOCK", [
    "BEGIN; COMMIT; LOCK TABLE migrationlens_probe IN SHARE MODE NOWAIT",
  ])
  let _ = successful("LOCK relation list and inheritance markers", [
    "BEGIN", "LOCK TABLE ONLY public.migrationlens_probe, public.migrationlens_probe* IN ROW SHARE MODE NOWAIT",
    "COMMIT",
  ])
  let analyzed = successful("ANALYZE columns and actual maintenance lock", [
    "BEGIN READ WRITE", "ANALYZE (VERBOSE FALSE, SKIP_LOCKED FALSE) ONLY public.migrationlens_probe (id)",
    "SELECT mode FROM pg_locks WHERE pid=pg_backend_pid() AND locktype='relation' AND relation='migrationlens_probe'::regclass AND granted AND mode='ShareUpdateExclusiveLock'",
    "COMMIT",
  ])
  assert_eq(analyzed.stdout().trim().to_owned(), "ShareUpdateExclusiveLock")
  let _ = successful("ANALYZE legacy verbose and relation list", [
    "ANALYZE VERBOSE public.migrationlens_probe (id), ONLY public.migrationlens_probe",
  ])
  let _ = successful("VACUUM supported options and column targets", [
    "VACUUM (ANALYZE TRUE, FULL FALSE, FREEZE ON, VERBOSE OFF, SKIP_LOCKED TRUE, INDEX_CLEANUP ON, TRUNCATE FALSE) ONLY public.migrationlens_probe (id)",
  ])
  let _ = successful("VACUUM FULL legacy options", [
    "VACUUM FULL FREEZE VERBOSE ANALYZE public.migrationlens_probe (id)",
  ])
  let _ = successful("VACUUM disabled cleanup and automatic cleanup", [
    "VACUUM (INDEX_CLEANUP OFF, TRUNCATE OFF) public.migrationlens_probe", "VACUUM (INDEX_CLEANUP AUTO, TRUNCATE 0) public.migrationlens_probe",
  ])
  rejected(
    "VACUUM explicit transaction",
    ["BEGIN READ WRITE", "VACUUM migrationlens_probe"],
    "25001",
  )
  rejected(
    "VACUUM implicit simple-query transaction",
    ["SET lock_timeout=100; VACUUM migrationlens_probe"],
    "25001",
  )
  rejected(
    "VACUUM implicit segment after COMMIT",
    ["BEGIN; COMMIT; VACUUM migrationlens_probe"],
    "25001",
  )
  let _ = successful("separate VACUUM then concurrent index", [
    "VACUUM (TRUNCATE FALSE) migrationlens_probe", "CREATE INDEX CONCURRENTLY ml_probe_postvac ON migrationlens_probe(id)",
    "DROP INDEX CONCURRENTLY ml_probe_postvac",
  ])
  let clustered = successful(
    "targeted CLUSTER in transaction holds rewrite lock",
    [
      "CREATE INDEX ml_probe_cluster ON migrationlens_probe(id)", "BEGIN", "CLUSTER (VERBOSE FALSE) public.migrationlens_probe USING ml_probe_cluster",
      "SELECT mode FROM pg_locks WHERE pid=pg_backend_pid() AND relation='migrationlens_probe'::regclass AND granted AND mode='AccessExclusiveLock'",
      "COMMIT",
    ],
  )
  assert_eq(clustered.stdout().trim().to_owned(), "AccessExclusiveLock")
  let _ = successful("remembered and database-wide CLUSTER", [
    "CLUSTER VERBOSE migrationlens_probe", "CLUSTER (VERBOSE OFF)",
  ])
  rejected(
    "database-wide CLUSTER in explicit transaction",
    ["BEGIN", "CLUSTER"],
    "25001",
  )
  rejected(
    "database-wide CLUSTER in implicit block",
    ["SET lock_timeout=100; CLUSTER"],
    "25001",
  )
  let _ = successful("create disposable materialized view", [
    "CREATE MATERIALIZED VIEW ml_probe_summary AS SELECT id FROM migrationlens_probe WITH DATA",
    "CREATE UNIQUE INDEX ml_probe_summary_key ON ml_probe_summary(id)",
  ])
  let refreshed = successful(
    "concurrent refresh is allowed in a transaction and holds EXCLUSIVE",
    [
      "BEGIN", "REFRESH MATERIALIZED VIEW CONCURRENTLY public.ml_probe_summary WITH DATA",
      "SELECT mode FROM pg_locks WHERE pid=pg_backend_pid() AND relation='ml_probe_summary'::regclass AND granted AND mode='ExclusiveLock'",
      "COMMIT",
    ],
  )
  assert_eq(refreshed.stdout().trim().to_owned(), "ExclusiveLock")
  rejected(
    "incompatible concurrent no-data refresh on a populated view",
    ["REFRESH MATERIALIZED VIEW CONCURRENTLY ml_probe_summary WITH NO DATA"],
    "42601",
  )
  let _ = successful("remove qualifying UNIQUE index", [
    "DROP INDEX ml_probe_summary_key",
  ])
  rejected(
    "concurrent refresh needs UNIQUE index",
    ["REFRESH MATERIALIZED VIEW CONCURRENTLY ml_probe_summary"],
    "55000",
  )
  let _ = successful("restore qualifying UNIQUE index", [
    "CREATE UNIQUE INDEX ml_probe_summary_key ON ml_probe_summary(id)",
  ])
  let unpopulated = successful(
    "ordinary no-data refresh holds ACCESS EXCLUSIVE and clears populated flag",
    [
      "BEGIN", "REFRESH MATERIALIZED VIEW ml_probe_summary WITH NO DATA", "SELECT mode FROM pg_locks WHERE pid=pg_backend_pid() AND relation='ml_probe_summary'::regclass AND granted AND mode='AccessExclusiveLock'",
      "SELECT relispopulated FROM pg_class WHERE oid='ml_probe_summary'::regclass",
      "COMMIT",
    ],
  )
  assert_eq(unpopulated.stdout().trim().to_owned(), "AccessExclusiveLock\nf")
  rejected(
    "no-data materialized view cannot be queried",
    ["SELECT * FROM ml_probe_summary"],
    "55000",
  )
  rejected(
    "unpopulated view cannot refresh concurrently",
    ["REFRESH MATERIALIZED VIEW CONCURRENTLY ml_probe_summary"],
    "0A000",
  )
  let _ = successful("repopulate before concurrent refresh", [
    "REFRESH MATERIALIZED VIEW ml_probe_summary WITH DATA", "REFRESH MATERIALIZED VIEW CONCURRENTLY ml_probe_summary",
    "DROP MATERIALIZED VIEW ml_probe_summary",
  ])
  let _ = successful("prepare previously installed constraints on real rows", [
    "INSERT INTO migrationlens_probe(id) VALUES (1), (2)", "CREATE TABLE ml_probe_parent(id integer PRIMARY KEY)",
    "INSERT INTO ml_probe_parent(id) VALUES (1), (2)", "ALTER TABLE migrationlens_probe ADD CONSTRAINT ml_probe_positive CHECK(id>0) NOT VALID, ADD CONSTRAINT ml_probe_notnull NOT NULL id NOT VALID, ADD CONSTRAINT ml_probe_fk FOREIGN KEY(id) REFERENCES ml_probe_parent(id) NOT VALID",
  ])
  let validated = successful(
    "validate CHECK and NOT NULL together under maintenance lock",
    [
      "BEGIN", "ALTER TABLE IF EXISTS ONLY public.migrationlens_probe VALIDATE CONSTRAINT ml_probe_positive, VALIDATE CONSTRAINT ml_probe_notnull",
      "SELECT mode FROM pg_locks WHERE pid=pg_backend_pid() AND relation='migrationlens_probe'::regclass AND granted AND mode='ShareUpdateExclusiveLock'",
      "SELECT bool_and(convalidated) FROM pg_constraint WHERE conrelid='migrationlens_probe'::regclass AND conname IN ('ml_probe_positive','ml_probe_notnull')",
      "COMMIT",
    ],
  )
  assert_eq(validated.stdout().trim().to_owned(), "ShareUpdateExclusiveLock\nt")
  let foreign_key = successful(
    "foreign-key validation locks referenced table",
    [
      "BEGIN", "ALTER TABLE migrationlens_probe* VALIDATE CONSTRAINT ml_probe_fk",
      "SELECT mode FROM pg_locks WHERE pid=pg_backend_pid() AND relation='ml_probe_parent'::regclass AND granted AND mode='RowShareLock'",
      "COMMIT",
    ],
  )
  assert_eq(foreign_key.stdout().trim().to_owned(), "RowShareLock")
  let _ = successful("install intentionally violated historical CHECK", [
    "ALTER TABLE migrationlens_probe ADD CONSTRAINT ml_probe_violated CHECK(id<0) NOT VALID",
  ])
  rejected(
    "validation detects existing data violations",
    ["ALTER TABLE migrationlens_probe VALIDATE CONSTRAINT ml_probe_violated"],
    "23514",
  )
  let _ = successful(
    "remove violation and revalidate an already valid constraint",
    [
      "ALTER TABLE migrationlens_probe DROP CONSTRAINT ml_probe_violated", "ALTER TABLE migrationlens_probe VALIDATE CONSTRAINT ml_probe_positive",
    ],
  )
  let _ = successful("prepare existing-index constraint workflow", [
    "CREATE TABLE ml_probe_attach(id integer, external_key text)", "INSERT INTO ml_probe_attach VALUES (1, 'order-1001'), (2, 'order-1002')",
    "CREATE UNIQUE INDEX CONCURRENTLY ml_probe_attach_idx ON ml_probe_attach(external_key)",
  ])
  let attached = successful("attach UNIQUE under table lock and rename index", [
    "BEGIN", "ALTER TABLE ml_probe_attach ADD CONSTRAINT ml_probe_attach_unique UNIQUE USING INDEX ml_probe_attach_idx",
    "SELECT mode FROM pg_locks WHERE pid=pg_backend_pid() AND relation='ml_probe_attach'::regclass AND granted AND mode='AccessExclusiveLock'",
    "SELECT conindid='ml_probe_attach_unique'::regclass FROM pg_constraint WHERE conrelid='ml_probe_attach'::regclass AND conname='ml_probe_attach_unique'",
    "COMMIT",
  ])
  assert_eq(attached.stdout().trim().to_owned(), "AccessExclusiveLock\nt")
  let removed = successful("constraint owns index lifetime", [
    "ALTER TABLE ml_probe_attach DROP CONSTRAINT ml_probe_attach_unique", "SELECT to_regclass('ml_probe_attach_unique') IS NULL",
  ])
  assert_eq(removed.stdout().trim().to_owned(), "t")
  let _ = successful("primary-key attachment establishes nullability", [
    "CREATE UNIQUE INDEX CONCURRENTLY ml_probe_attach_pk ON ml_probe_attach(id)",
    "ALTER TABLE ml_probe_attach ADD PRIMARY KEY USING INDEX ml_probe_attach_pk DEFERRABLE INITIALLY DEFERRED",
  ])
  let primary = successful("inspect attached primary-key attributes", [
    "SELECT attnotnull FROM pg_attribute WHERE attrelid='ml_probe_attach'::regclass AND attname='id'",
    "SELECT condeferrable AND condeferred FROM pg_constraint WHERE conrelid='ml_probe_attach'::regclass AND contype='p'",
  ])
  assert_eq(primary.stdout().trim().to_owned(), "t\nt")
  let _ = successful("remove attachment probe table", [
    "DROP TABLE ml_probe_attach",
  ])
  let _ = successful("remove disposable probe tables", [
    "DROP TABLE migrationlens_probe", "DROP TABLE ml_probe_parent",
  ])
  println(
    "PostgreSQL 18 transaction, timeout, lock and maintenance execution probes passed",
  )
}
