///|
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn main {
  let moon = @env.get_env_var("MIGRATIONLENS_MOON").unwrap_or("moon")
  let target = @env.args().get(1).unwrap_or("wasm")
  guard ["wasm", "wasm-gc", "js", "native"].contains(target) else {
    fail("invalid target")
  }
  let cases : Array[(String, String, Bool, Int32)] = [
    ("fixtures/postgres-migrations-concurrent.sql", "separate", false, 0),
    ("fixtures/postgres-migrations-no-transaction.sql", "transaction", false, 1),
    ("fixtures/postgres-migrations-concurrent.sql", "unknown", false, 2),
    ("fixtures/batch-indexes.sql", "simple", false, 1),
    ("fixtures/batch-indexes.sql", "separate", false, 0),
    ("fixtures/session-timeout.sql", "separate", true, 0),
    ("fixtures/session-timeout.sql", "simple", true, 1),
    ("fixtures/savepoint-timeout.sql", "separate", true, 1),
    ("fixtures/chained-transaction.sql", "separate", true, 0),
    ("fixtures/drop-indexes.sql", "separate", false, 1),
    ("fixtures/reindex.sql", "separate", true, 0),
    ("fixtures/reindex.sql", "simple", true, 1),
    ("fixtures/replace-index.sql", "separate", true, 1),
    ("fixtures/river-006-bulk-unique.sql", "separate", false, 2),
  ]
  for (file, mode, timeout, expected) in cases {
    let args = [
      "run", "--target", target, "cmd/main", "--", file, mode, "--json",
    ]
    if timeout {
      args.push("--require-lock-timeout")
    }
    let output = @shell.Cmd(moon, args).output(timeout_ms=60000)
    assert_eq(output.exit_code(), expected, msg=file)
    let data = @json.parse(output.stdout())
    if file == "fixtures/savepoint-timeout.sql" {
      assert_true(output.stdout().contains("ML201"))
    }
    if file == "fixtures/drop-indexes.sql" {
      assert_true(output.stdout().contains("ML107"))
    }
    if file == "fixtures/replace-index.sql" {
      assert_true(output.stdout().contains("ML110"))
      assert_true(!output.stdout().contains("ML003"))
    }
    if file == "fixtures/river-006-bulk-unique.sql" {
      assert_true(output.stdout().contains("ML003"))
    }
    assert_eq(@json.parse(data.stringify()), data)
    let again = @shell.Cmd(moon, args).output(timeout_ms=60000)
    assert_eq(again.stdout(), output.stdout(), msg="deterministic report")
  }
  @fs.mkdir("_build", allow_exist=true)
  for
    (file, mode, expected) in [
      ("fixtures/batch-indexes.sql", "separate", 0),
      ("fixtures/batch-indexes.sql", "simple", 1),
      ("fixtures/river-006-bulk-unique.sql", "separate", 2),
    ] {
    let args = [
      "run", "--target", target, "cmd/main", "--", file, mode, "--sarif",
    ]
    let output = @shell.Cmd(moon, args).output(timeout_ms=60000)
    assert_eq(output.exit_code(), expected)
    let data = @json.parse(output.stdout())
    guard data is { "version": "2.1.0", "runs": [run], .. } else {
      fail("invalid SARIF envelope")
    }
    guard run
      is {
        "invocations": [
          { "executionSuccessful": success, "exitCode": code, .. },
        ],
        "artifacts": [{ "contents": { "text": source, .. }, .. }],
        "results": results,
        ..
      } else {
      fail("missing SARIF fields")
    }
    assert_eq(success, Json(expected != 2))
    assert_eq(code, Json(expected))
    assert_eq(source, Json(@fs.read_file(file).text()))
    assert_eq(@json.parse(data.stringify()), data)
    guard results is Array(items) else { fail("missing SARIF results") }
    if expected == 0 {
      assert_true(items.is_empty())
    } else {
      assert_true(!items.is_empty())
    }
    let again = @shell.Cmd(moon, args).output(timeout_ms=60000)
    assert_eq(again.stdout(), output.stdout())
    @fs.write_file("_build/sarif-\{expected}.json", output.stdout())
  }
  for (maximum, expected) in [("2000", 1), ("10000", 0)] {
    let args = [
      "run",
      "--target",
      target,
      "cmd/main",
      "--",
      "fixtures/timeout-limit.sql",
      "separate",
      "--json",
      "--max-lock-timeout-ms=\{maximum}",
    ]
    let output = @shell.Cmd(moon, args).output(timeout_ms=60000)
    assert_eq(output.exit_code(), expected)
    let data = @json.parse(output.stdout())
    assert_eq(@json.parse(data.stringify()), data)
    assert_eq(output.stdout().contains("ML205"), expected == 1)
    let again = @shell.Cmd(moon, args).output(timeout_ms=60000)
    assert_eq(again.stdout(), output.stdout())
  }
  let initial = @shell.Cmd(moon, [
    "run", "--target", target, "cmd/main", "--", "fixtures/close-transaction.sql",
    "simple", "--initial-transaction", "--json",
  ]).output(timeout_ms=60000)
  assert_eq(initial.exit_code(), 1)
  assert_true(
    initial.stdout().contains("ML105") && initial.stdout().contains("ML101"),
  )
  for
    invalid_args in [
      [],
      ["_build/missing-migrationlens-file.sql", "separate"],
      ["fixtures/batch-indexes.sql", "bogus"],
      ["fixtures/batch-indexes.sql", "separate", "--bogus"],
      ["fixtures/batch-indexes.sql", "separate", "--json", "--sarif"],
      ["./fixtures/batch-indexes.sql", "separate", "--sarif"],
      ["fixtures/timeout-limit.sql", "separate", "--max-lock-timeout-ms=0"],
      ["fixtures/timeout-limit.sql", "separate", "--max-lock-timeout-ms=-1"],
      [
        "fixtures/timeout-limit.sql", "separate", "--max-lock-timeout-ms=2147483648",
      ],
      ["fixtures/timeout-limit.sql", "separate", "--max-lock-timeout-ms=2s"],
      ["fixtures/timeout-limit.sql", "separate", "--max-lock-timeout-ms="],
      [
        "fixtures/timeout-limit.sql", "separate", "--max-lock-timeout-ms=1", "--max-lock-timeout-ms=2",
      ],
    ] {
    let args = ["run", "--target", target, "cmd/main", "--"]
    for arg in invalid_args {
      args.push(arg)
    }
    let output = @shell.Cmd(moon, args).output(timeout_ms=60000)
    assert_eq(output.exit_code(), 2)
  }
  @fs.write_file("_build/invalid-utf8.sql", b"\xff\xfe\x00")
  let invalid = @shell.Cmd(moon, [
    "run", "--target", target, "cmd/main", "--", "_build/invalid-utf8.sql", "separate",
  ]).output(timeout_ms=60000)
  assert_eq(invalid.exit_code(), 2)
  assert_true(invalid.stdout().contains("Cannot read UTF-8"))
  for format in ["--json", "--sarif"] {
    let args = [
      "run", "--target", target, "cmd/batch", "--", "fixtures/review-manifest.json",
      format,
    ]
    let output = @shell.Cmd(moon, args).output(timeout_ms=60000)
    assert_eq(output.exit_code(), 2)
    let data = @json.parse(output.stdout())
    if format == "--json" {
      guard data
        is { "exit_code": 2, "files": [clean, warning, incomplete], .. } else {
        fail("batch must retain every file")
      }
      guard clean
        is { "report": { "complete": true, "diagnostics": [], .. }, .. } else {
        fail("clean file lost")
      }
      guard warning is { "report": { "complete": true, .. }, .. } else {
        fail("covered file lost")
      }
      guard incomplete is { "report": { "complete": false, .. }, .. } else {
        fail("incomplete file lost")
      }
    } else {
      guard data is { "version": "2.1.0", "runs": [_, _, _], .. } else {
        fail("expected three independent SARIF runs")
      }
      @fs.write_file("_build/sarif-batch.json", output.stdout())
    }
    assert_eq(@json.parse(data.stringify()), data)
    let again = @shell.Cmd(moon, args).output(timeout_ms=60000)
    assert_eq(again.stdout(), output.stdout())
  }
  for
    (path, expected) in [
      ("fixtures/postgres-migrations-concurrent.sql", 0),
      ("fixtures/replace-index.sql", 1),
    ] {
    @fs.write_file(
      "_build/batch-one.json",
      "{\"format_version\":1,\"migrations\":[{\"path\":\"\{path}\",\"execution\":\"separate\"}]}",
    )
    let output = @shell.Cmd(moon, [
      "run", "--target", target, "cmd/batch", "--", "_build/batch-one.json",
    ]).output(timeout_ms=60000)
    assert_eq(output.exit_code(), expected)
    assert_true(output.stdout().contains("MigrationLens batch: 1 files"))
  }
  for
    malformed in [
      "{\"format_version\":1,\"migrations\":[],\"unknown\":true}", "{\"format_version\":1,\"migrations\":[{\"path\":\"a\",\"path\":\"b\",\"execution\":\"separate\"}]}",
      "{\"format_version\":1,\"migrations\":[{\"path\":\"_build/no-such-batch-file.sql\",\"execution\":\"separate\"}]}",
      "{\"format_version\":1,\"migrations\":[{\"path\":\"_build/invalid-utf8.sql\",\"execution\":\"separate\"}]}",
    ] {
    @fs.write_file("_build/batch-invalid.json", malformed)
    let output = @shell.Cmd(moon, [
      "run", "--target", target, "cmd/batch", "--", "_build/batch-invalid.json",
      "--json",
    ]).output(timeout_ms=60000)
    assert_eq(output.exit_code(), 2)
    assert_true(output.stdout().contains("Cannot review migration manifest:"))
  }
  for
    args in [
      [],
      ["_build/invalid-utf8.sql"],
      ["fixtures/review-manifest.json", "--bad"],
      ["fixtures/review-manifest.json", "--json", "--sarif"],
    ] {
    let command = ["run", "--target", target, "cmd/batch", "--"]
    for arg in args {
      command.push(arg)
    }
    let output = @shell.Cmd(moon, command).output(timeout_ms=60000)
    assert_eq(output.exit_code(), 2)
  }
  @fs.write_file(
    "_build/batch-one.json", "{\"format_version\":1,\"migrations\":[{\"path\":\"fixtures/postgres-migrations-concurrent.sql\",\"execution\":\"separate\"}]}",
  )
  let recovery = @shell.Cmd(moon, [
    "run", "--target", target, "cmd/batch", "--", "_build/batch-one.json", "--json",
  ]).output(timeout_ms=60000)
  assert_eq(recovery.exit_code(), 0)
  println(
    "Single-file/batch CLI, JSON/SARIF, determinism and malformed input checks passed on \{target}",
  )
}
